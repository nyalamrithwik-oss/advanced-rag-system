# ============================================================================
# Advanced RAG API - Environment Configuration
# ============================================================================
# Copy this file to .env and update with your actual values

# ============================================================================
# API Authentication
# ============================================================================
# API key for authentication (X-API-Key header required)
# Keep this secret in production!
API_KEY=your_api_key_here

# ============================================================================
# Rate Limiting
# ============================================================================
# Maximum requests per minute per API key
MAX_REQUESTS_PER_MINUTE=10

# ============================================================================
# Input Validation
# ============================================================================
# Maximum length for search queries (characters)
MAX_QUERY_LENGTH=500

# Maximum file size for uploads (MB)
MAX_FILE_SIZE_MB=10

# ============================================================================
# OpenAI API Keys
# ============================================================================
# Required for query transformation and LLM operations
OPENAI_API_KEY=your_openai_api_key_here

# ============================================================================
# Pinecone Configuration (for vector search)
# ============================================================================
# Pinecone API key
PINECONE_API_KEY=your_pinecone_api_key_here

# Pinecone environment (e.g., us-west-2-aws, gcp-starter)
PINECONE_ENV=your_environment_here

# Pinecone index name
PINECONE_INDEX=your_index_name_here

# ============================================================================
# Cohere Configuration (for reranking)
# ============================================================================
# Cohere API key for semantic reranking
COHERE_API_KEY=your_cohere_api_key_here

# ============================================================================
# Database Configuration
# ============================================================================
# Database URL for storing conversations and metadata
# Example: sqlite:///./data/rag.db
DATABASE_URL=sqlite:///./data/rag.db

# ============================================================================
# Logging Configuration
# ============================================================================
# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Directory for log files
LOG_DIR=logs

# ============================================================================
# Server Configuration
# ============================================================================
# Server host
SERVER_HOST=0.0.0.0

# Server port
SERVER_PORT=8000

# Environment (development, production)
ENVIRONMENT=development

# ============================================================================
# CORS Configuration
# ============================================================================
# Allowed CORS origins (comma-separated)
# Use * for development, specific domains for production
ALLOWED_ORIGINS=*

# ============================================================================
# SSL/TLS Configuration (Production)
# ============================================================================
# Enable HTTPS
USE_HTTPS=false

# Path to SSL certificate
SSL_CERT_PATH=/path/to/cert.pem

# Path to SSL key
SSL_KEY_PATH=/path/to/key.pem

# ============================================================================
# Monitoring Configuration
# ============================================================================
# Enable metrics collection
ENABLE_METRICS=true

# Metrics file location
METRICS_FILE=logs/metrics.json

# Performance monitoring threshold (seconds) - alert on slow queries
SLOW_QUERY_THRESHOLD=30
